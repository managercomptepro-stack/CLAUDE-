rules_version = '2';

// NIOXXER v2 — the whole security of the site (no server: Spark plan). docs/ARCHITECTURE.md § 5.
// Every rule has an "allowed" and a "denied" test in tests/rules/.
service cloud.firestore {
  match /databases/{database}/documents {

    // <shared> generated by `npm run rules:sync` from src/data — do not edit by hand
    function forbiddenTextPattern() { return '(?s).*((^|[^a-z0-9àâäçéèêëîïôöùûüÿœæÀÂÄÇÉÈÊËÎÏÔÖÙÛÜŸŒÆ])(mineure?s?|minors?|under ?age|ados?|adolescente?s?|teens?|teenagers?|coll[eéÉ]gien(ne)?s?|lyc[eéÉ]en(ne)?s?|[eéÉ]coli[eèÈ]re?s?|school ?girls?|school ?boys?|lolitas?|loli|p[eéÉ]dos?|p[eéÉ]dophiles?|fillettes?|gamine?s?|petite?s? filles?|petits? gar[cçÇ]ons?|jeune fille de 1[0-7]|1[0-7] ?ans|1[0-7] ?years?|1[0-7] ?yrs?|1[0-7] ?(yo|y/o)|(dix|onze|douze|treize|quatorze|quinze|seize|dix[- ]?sept) ?ans)([^a-z0-9àâäçéèêëîïôöùûüÿœæÀÂÄÇÉÈÊËÎÏÔÖÙÛÜŸŒÆ]|$)|(^|[^a-z0-9àâäçéèêëîïôöùûüÿœæÀÂÄÇÉÈÊËÎÏÔÖÙÛÜŸŒÆ])([0-9][0-9 .]* ?(fr|frs|francs?|fcfa|cfa|xaf|mil|mille|balles)|[0-9]([ .]?[0-9]){2,} ?f|[0-9]+k|f ?cfa|cfa|xaf|tarifs?|tarif[eéÉ]e?s?|prix|payante?s?|r[eéÉ]mun[eéÉ]r[a-zéèÉÈ]*|money|escorte?s?|bizi|wolowoss|tchoko|shorts? ?times?|shots? ?times?|longs? ?times?|per night|par nuit|la nuit [aàÀ] [0-9]|une passe|la passe|pay me)([^a-z0-9àâäçéèêëîïôöùûüÿœæÀÂÄÇÉÈÊËÎÏÔÖÙÛÜŸŒÆ]|$)|([0-9]([ ./-]{0,3}[0-9]){7}|wa[.]me|whatsapp[.]com|t[.]me/|https?:|www[.]|@[a-z0-9-]+[.][a-z]{2,})).*'; }
    function photoListPattern() { return '^[A-Za-z0-9_-]{1,100}:[1-9][0-9]{0,3}x[1-9][0-9]{0,3}( [A-Za-z0-9_-]{1,100}:[1-9][0-9]{0,3}x[1-9][0-9]{0,3}){0,4}$'; }
    function pseudoPattern() { return '^[a-z0-9][a-z0-9_.-]{2,19}$'; }
    function whatsappPattern() { return '^[+]2376[0-9]{8}$'; }
    function reservedPseudoPattern() { return '.*(nioxxer|admin|moderat|support|officiel|staff|equipe).*'; }
    function photoUrlPattern() { return '^https://res[.]cloudinary[.]com/bcxiwwkh/image/upload/v[0-9]{1,12}/[A-Za-z0-9_-]{1,100}[.](jpg|jpeg|png|webp|heic)$'; }
    function adultMinDays() { return 6575; }
    function listingLifetimeDays() { return 180; }
    function strikesBanThreshold() { return 5; }
    function photosMin() { return 1; }
    function photosMax() { return 5; }
    function dataUrlMaxChars() { return 410000; }
    function lenPseudo() { return [3, 20]; }
    function lenTitle() { return [3, 60]; }
    function lenDescription() { return [10, 1000]; }
    function lenOffer() { return [0, 300]; }
    function lenDistrict() { return [2, 40]; }
    function maxReportNote() { return 300; }
    function maxReason() { return 300; }
    function maxTxRef() { return 60; }
    function genrePattern() { return '^(femme|homme|gay|lesbienne|trans|couple|autre)$'; }
    function citySlugPattern() { return '^(douala|yaounde|garoua|bamenda|maroua|bafoussam|ngaoundere|bertoua|edea|loum|kumba|nkongsamba|buea|kumbo|foumban|dschang|ebolowa|kousseri|guider|mbouda|limbe|kribi|bafang|tiko|mbalmayo|sangmelima|meiganga|bafia)$'; }
    function reportReasonPattern() { return '^(minor|paid_sex|stolen_photos|scam|shocking|fake_profile|other)$'; }
    function notificationTypePattern() { return '^(boost_approved|boost_rejected|badge_granted|badge_refused|listing_removed|warning)$'; }
    function auditTargetTypePattern() { return '^(settings|admin|user|profile|listing|boostRequest|verification)$'; }
    // </shared>

    // ── Identity ───────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(userId) { return signedIn() && uid() == userId; }
    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function isVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function adminRole() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : 'none';
    }
    function isAdmin() { return adminRole() in ['super', 'moderator']; }
    function isSuper() { return adminRole() == 'super'; }

    // ── Helpers ────────────────────────────────────────────────────────────
    function settings() { return get(/databases/$(database)/documents/settings/public).data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function exactKeys(d, keys) { return d.keys().hasOnly(keys) && d.keys().hasAll(keys); }
    function sized(t, min, max) { return t is string && t.size() >= min && t.size() <= max; }

    // Text accepted: no minor-related term, no price, no contact detail (one combined regex on
    // the lower-cased text: rules stop after 1000 evaluated expressions per request).
    function cleanText(t) { return !t.lower().matches(forbiddenTextPattern()); }
    function textOk(t, len) {
      return sized(t, len[0], len[1]) && cleanText(t);
    }

    function isAdultBirth(d) {
      return d is timestamp && d <= request.time - duration.value(adultMinDays(), 'd');
    }
    function firstOfMonth(d) { return timestamp.date(d.year(), d.month(), 1); }
    function validWhatsapp(w) { return w is string && w.matches(whatsappPattern()); }
    function validCity(slug) { return slug is string && slug.matches(citySlugPattern()); }
    function validGenre(g) { return g is string && g.matches(genrePattern()); }
    function validPhotoUrl(u) {
      return u == null || (u is string && u.size() <= 300 && u.matches(photoUrlPattern()));
    }
    function validDataUrl(s) {
      return s is string && s.size() <= dataUrlMaxChars()
        && s.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }

    // Admin writes must create a NEW auditLog entry in the same batch (CLAUDE.md § 4.8): the
    // written document carries its id in `auditId`.
    function audited(targetType, targetId) {
      let aid = request.resource.data.get('auditId', null);
      return aid is string
        && !exists(/databases/$(database)/documents/auditLog/$(aid))
        && existsAfter(/databases/$(database)/documents/auditLog/$(aid))
        && getAfter(/databases/$(database)/documents/auditLog/$(aid)).data.actorUid == uid()
        && getAfter(/databases/$(database)/documents/auditLog/$(aid)).data.targetType == targetType
        && getAfter(/databases/$(database)/documents/auditLog/$(aid)).data.targetId == targetId;
    }

    // Same-batch audit entry written by this admin (documents that only reference it).
    function auditedBy(aid) {
      return aid is string
        && !exists(/databases/$(database)/documents/auditLog/$(aid))
        && existsAfter(/databases/$(database)/documents/auditLog/$(aid))
        && getAfter(/databases/$(database)/documents/auditLog/$(aid)).data.actorUid == uid();
    }

    // ── settings/public ────────────────────────────────────────────────────
    function validPayee(p) {
      return p is map && exactKeys(p, ['number', 'name'])
        && sized(p.number, 0, 20) && sized(p.name, 0, 60);
    }
    function validSettings(d) {
      return d.keys().hasOnly(['prices', 'boostDays', 'payment', 'maxActiveListings',
          'reportsHideThreshold', 'supportWhatsApp', 'termsVersion', 'auditId'])
        && d.keys().hasAll(['prices', 'boostDays', 'payment', 'maxActiveListings',
          'reportsHideThreshold', 'supportWhatsApp', 'termsVersion'])
        && d.prices is map && exactKeys(d.prices, ['premium', 'sponsored'])
        && d.prices.premium is int && d.prices.premium > 0
        && d.prices.sponsored is int && d.prices.sponsored > 0
        && d.boostDays is map && exactKeys(d.boostDays, ['premium', 'sponsored'])
        && d.boostDays.premium is int && d.boostDays.premium >= 1 && d.boostDays.premium <= 90
        && d.boostDays.sponsored is int && d.boostDays.sponsored >= 1 && d.boostDays.sponsored <= 90
        && d.payment is map && exactKeys(d.payment, ['mtn', 'orange'])
        && validPayee(d.payment.mtn) && validPayee(d.payment.orange)
        && d.maxActiveListings is int && d.maxActiveListings >= 1 && d.maxActiveListings <= 20
        && d.reportsHideThreshold is int && d.reportsHideThreshold >= 2 && d.reportsHideThreshold <= 100
        && d.supportWhatsApp is string && d.supportWhatsApp.matches('^[+][1-9][0-9]{7,14}$')
        && sized(d.termsVersion, 1, 20);
    }

    match /settings/{settingsId} {
      allow read: if settingsId == 'public';
      allow create, update: if settingsId == 'public' && isSuper()
        && validSettings(request.resource.data) && audited('settings', 'public');
      allow delete: if false;
    }

    // ── admins/{uid} — the first super-admin is created by hand in the console ──
    match /admins/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list: if isSuper();
      allow create, update: if isSuper() && adminUid != uid()
        && (!exists(/databases/$(database)/documents/admins/$(adminUid))
          || get(/databases/$(database)/documents/admins/$(adminUid)).data.role != 'super')
        && exactKeys(request.resource.data, ['role', 'addedBy', 'addedAt', 'auditId'])
        && request.resource.data.role in ['moderator', 'none']
        && request.resource.data.addedBy == uid()
        && request.resource.data.addedAt == request.time
        && audited('admin', adminUid);
      allow delete: if false;
    }

    // ── users/{uid} — private profile ──────────────────────────────────────
    function validNewUser(d) {
      return exactKeys(d, ['email', 'birthDate', 'genre', 'city', 'whatsapp', 'termsVersion',
          'termsAcceptedAt', 'createdAt', 'strikes', 'publishBanned'])
        && d.email == request.auth.token.email
        && isAdultBirth(d.birthDate)
        && validGenre(d.genre)
        && validCity(d.city)
        && validWhatsapp(d.whatsapp)
        && d.termsVersion == settings().termsVersion
        && d.termsAcceptedAt == request.time
        && d.createdAt == request.time
        && d.strikes == 0
        && d.publishBanned == false;
    }
    function ownerUserUpdate() {
      let d = request.resource.data;
      return !('deletionRequestedAt' in resource.data)
        && changed().hasOnly(['city', 'whatsapp', 'termsVersion', 'termsAcceptedAt'])
        && validCity(d.city) && validWhatsapp(d.whatsapp)
        && (!changed().hasAny(['termsVersion', 'termsAcceptedAt'])
          || (d.termsVersion == settings().termsVersion && d.termsAcceptedAt == request.time));
    }
    // A moderator's strike counts one listing of this member removed in the same batch: its id is
    // in the audit entry (`after.listingId`), and it goes from active to removed (no strike twice).
    function strikeForRemoval(userId) {
      let entry = getAfter(/databases/$(database)/documents/auditLog/$(request.resource.data.auditId)).data;
      let lid = entry.after.get('listingId', '');
      return lid is string && lid.split('_')[0] == userId
        && get(/databases/$(database)/documents/listings/$(lid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/listings/$(lid)).data.status == 'removed';
    }
    // `sanctions/{uid}` mirrors strikes + publishBanned for the moderators, who no longer read the
    // private record (owner's decision of 3 Oct 2026): every change keeps both in step.
    function sanctionsPath(userId) { return /databases/$(database)/documents/sanctions/$(userId); }
    function sanctionsInStep(userId) {
      let m = getAfter(sanctionsPath(userId)).data;
      return m.strikes == request.resource.data.strikes && m.publishBanned == request.resource.data.publishBanned;
    }
    function adminUserUpdate(userId) {
      let d = request.resource.data;
      return changed().hasOnly(['strikes', 'publishBanned', 'auditId'])
        && d.strikes is int && d.publishBanned is bool
        && audited('user', userId)
        && sanctionsInStep(userId)
        && ((isSuper() && d.strikes >= 0)
          || (d.strikes == resource.data.strikes + 1
            && d.publishBanned == (resource.data.publishBanned || d.strikes >= strikesBanThreshold())
            && strikeForRemoval(userId)));
    }

    // Account deletion is a request (owner's decision of 3 Oct 2026): set once, at server time, never
    // taken back by the member. The account is then frozen (no publishing, no edits) and its data
    // stays readable by the admins until the super-admin or the nightly job erases it (60 days).
    function ownerDeletionRequest() {
      return !('deletionRequestedAt' in resource.data)
        && changed().hasOnly(['deletionRequestedAt'])
        && request.resource.data.deletionRequestedAt == request.time;
    }
    function deletionRequested(userId) {
      return 'deletionRequestedAt' in get(/databases/$(database)/documents/users/$(userId)).data;
    }
    function tombstonePath(userId) { return /databases/$(database)/documents/deletedAccounts/$(userId); }
    // Erase by the super-admin, last write of the erase: the public profile is gone, a tombstone
    // tells the nightly job to remove the sign-in account. A sanctioned account keeps its record
    // (decision 13), marked as erased.
    function superErase(userId) {
      return isSuper() && 'deletionRequestedAt' in resource.data
        && !existsAfter(profilePath(userId)) && existsAfter(tombstonePath(userId));
    }

    // users + publicProfiles + usernames are created together (sign-up) and deleted together
    // (account deletion): no way to recreate one of them alone to reset strikes, a ban, the
    // birth date or the pseudo. An account with strikes keeps its private record.
    function profilePath(userId) { return /databases/$(database)/documents/publicProfiles/$(userId); }
    function userPath(userId) { return /databases/$(database)/documents/users/$(userId); }

    match /users/{userId} {
      // E-mail, birth date, WhatsApp: the member and the super-admin only (owner's decision of
      // 3 Oct 2026; moderators read `sanctions/{uid}`).
      allow get: if isOwner(userId) || isSuper();
      allow list: if isSuper();
      // Not again with the uid of an erased account (its sign-in account is removed at night).
      allow create: if isOwner(userId) && !isAnonymous() && validNewUser(request.resource.data)
        && getAfter(profilePath(userId)).data.memberSince == request.time
        && !exists(tombstonePath(userId));
      allow update: if (isOwner(userId) && (ownerUserUpdate() || ownerDeletionRequest()))
        || (isAdmin() && adminUserUpdate(userId))
        || (isSuper() && changed().hasOnly(['maxListings', 'auditId']) && audited('user', userId)
          && (request.resource.data.maxListings == null
            || (request.resource.data.maxListings is int
              && request.resource.data.maxListings >= 0 && request.resource.data.maxListings <= 50)))
        || (superErase(userId) && changed().hasOnly(['erasedAt', 'auditId', 'deletionRequestedAt'])
          && !('deletionRequestedAt' in request.resource.data)
          && request.resource.data.erasedAt == request.time && audited('user', userId));
      // No self-delete: an account leaves only by a request erased by the super-admin or the
      // nightly job (security audit of 3 Oct 2026: a member could delete and recreate it).
      allow delete: if superErase(userId) && resource.data.strikes == 0 && resource.data.publishBanned == false;

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || (isSuper() && deletionRequested(userId));
        // Sent with an audit entry of the same batch (trace of who wrote what to the member);
        // payment and badge news come from the super-admin only.
        allow create: if isAdmin()
          && exactKeys(request.resource.data, ['type', 'title', 'body', 'read', 'createdAt', 'auditId'])
          && request.resource.data.type is string && request.resource.data.type.matches(notificationTypePattern())
          && (isSuper() || !request.resource.data.type.matches('^(boost|badge)_.*'))
          && auditedBy(request.resource.data.auditId)
          && sized(request.resource.data.title, 1, 120)
          && sized(request.resource.data.body, 0, 1000)
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && changed().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if isOwner(userId) || (isSuper() && deletionRequested(userId));
      }
    }

    // ── sanctions/{uid} — strikes and publication ban, readable by the team ─────────────
    match /sanctions/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && exactKeys(request.resource.data, ['strikes', 'publishBanned'])
        && request.resource.data.strikes == getAfter(userPath(userId)).data.strikes
        && request.resource.data.publishBanned == getAfter(userPath(userId)).data.publishBanned;
      allow delete: if isSuper() && !existsAfter(userPath(userId));
    }

    // ── deletedAccounts/{uid} — erased by the super-admin, sign-in account left to remove ──
    match /deletedAccounts/{userId} {
      // The member reads their own: the sign-in page then offers to finish the deletion.
      allow get: if isSuper() || isOwner(userId);
      allow list: if isSuper();
      allow create: if isSuper() && deletionRequested(userId)
        && exactKeys(request.resource.data, ['erasedAt', 'auditId'])
        && request.resource.data.erasedAt == request.time
        && audited('user', userId);
      allow update, delete: if false;
    }

    // ── publicProfiles/{uid} + usernames/{pseudoLower} ─────────────────────
    function validNewProfile(userId, d) {
      return exactKeys(d, ['pseudo', 'photoUrl', 'memberSince', 'verified'])
        && sized(d.pseudo, lenPseudo()[0], lenPseudo()[1])
        && d.pseudo.lower().matches(pseudoPattern())
        && !d.pseudo.lower().matches(reservedPseudoPattern())
        && cleanText(d.pseudo)
        && validPhotoUrl(d.photoUrl)
        && d.memberSince == request.time
        && d.verified == false
        && getAfter(/databases/$(database)/documents/usernames/$(d.pseudo.lower())).data.uid == userId;
    }

    match /publicProfiles/{userId} {
      // One profile at a time for everyone; the whole list of members for the team only (being
      // registered on a dating site is sensitive: security audit of 3 Oct 2026).
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isOwner(userId) && !isAnonymous()
        && validNewProfile(userId, request.resource.data)
        && getAfter(userPath(userId)).data.createdAt == request.time;
      allow update: if (isOwner(userId) && changed().hasOnly(['photoUrl'])
          && validPhotoUrl(request.resource.data.photoUrl))
        || (isSuper() && changed().hasOnly(['verified', 'auditId'])
          && request.resource.data.verified is bool && audited('profile', userId));
      allow delete: if isSuper() && deletionRequested(userId);
    }

    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && !isAnonymous()
        && exactKeys(request.resource.data, ['uid'])
        && request.resource.data.uid == uid()
        && name.matches(pseudoPattern())
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.pseudo.lower() == name;
      allow update: if false;
      allow delete: if isSuper() && deletionRequested(resource.data.uid);
    }

    // ── listings/{uid_n} ───────────────────────────────────────────────────
    function ownsListingId(listingId) { return signedIn() && listingId.split('_')[0] == uid(); }
    // id = {uid}_{n}, 1 ≤ n ≤ cap: the slot carries the per-account cap. The cap is the account's own
    // (`users.maxListings`, set by the super-admin, owner's request of 3 Oct 2026) or the general one.
    function listingCap() {
      let own = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('maxListings', null);
      return own == null ? settings().maxActiveListings : own;
    }
    function isOwnListingId(listingId) {
      return ownsListingId(listingId)
        && listingId.matches('^[A-Za-z0-9]+_[1-9][0-9]?$')
        && int(listingId.split('_')[1]) <= listingCap();
    }
    function canPublish() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isVerified() && user.publishBanned == false && !('deletionRequestedAt' in user);
    }
    // Photos: list of « listings/<publicId>:<w>x<h> » strings, checked in one regex.
    function validPhotos(ps) {
      return ps is list && ps.size() >= photosMin() && ps.size() <= photosMax()
        && ps.join(' ').matches(photoListPattern());
    }
    function listingContentOk(d) {
      return validGenre(d.genre)
        && validCity(d.citySlug)
        && textOk(d.district, lenDistrict())
        && textOk(d.title, lenTitle())
        && textOk(d.description, lenDescription())
        && textOk(d.offer, lenOffer())
        && validPhotos(d.photos)
        && d.contactMode in ['message', 'call_message'];
    }
    function contactMatches(listingId, d) {
      return getAfter(/databases/$(database)/documents/listings/$(listingId)/private/contact).data.callAllowed
        == (d.contactMode == 'call_message');
    }
    function validNewListing(listingId, d) {
      let profile = get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data;
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return exactKeys(d, ['ownerUid', 'pseudo', 'profilePhotoUrl', 'verified', 'memberSince',
          'birthMonth', 'genre', 'citySlug', 'district', 'title', 'description', 'offer',
          'photos', 'contactMode', 'rank', 'boostUntil', 'views', 'likes', 'reportsCount',
          'hidden', 'status', 'removedReason', 'createdAt', 'updatedAt', 'renewedAt'])
        && d.ownerUid == uid()
        && d.pseudo == profile.pseudo
        && d.profilePhotoUrl == profile.photoUrl
        && d.verified == profile.verified
        && d.memberSince == profile.memberSince
        && d.birthMonth == firstOfMonth(user.birthDate)
        && listingContentOk(d)
        && d.rank == 0 && d.boostUntil == null
        && d.views == 0 && d.likes == 0 && d.reportsCount == 0
        && d.hidden == false && d.status == 'active' && d.removedReason == null
        && d.createdAt == request.time && d.updatedAt == request.time && d.renewedAt == request.time
        && contactMatches(listingId, d);
    }
    function ownerEdit(listingId) {
      let d = request.resource.data;
      return signedIn() && resource.data.ownerUid == uid() && canPublish()
        && resource.data.status == 'active'
        && changed().hasOnly(['genre', 'citySlug', 'district', 'title', 'description',
          'offer', 'photos', 'contactMode', 'profilePhotoUrl', 'updatedAt', 'renewedAt'])
        && listingContentOk(d)
        && d.updatedAt == request.time
        && (d.renewedAt == resource.data.renewedAt || d.renewedAt == request.time)
        && (d.profilePhotoUrl == resource.data.profilePhotoUrl
          || d.profilePhotoUrl == getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.photoUrl)
        && contactMatches(listingId, d);
    }
    // Deletion request: the member closes their active listings in the same batch (never reopened).
    function ownerClose() {
      return signedIn() && resource.data.ownerUid == uid()
        && resource.data.status == 'active'
        && changed().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'closed'
        && request.resource.data.updatedAt == request.time
        && 'deletionRequestedAt' in getAfter(userPath(request.auth.uid)).data;
    }
    function isPublic(d) { return d.status == 'active' && d.hidden == false; }
    function viewIncrement() {
      return changed().hasOnly(['views']) && isPublic(resource.data)
        && request.resource.data.views == resource.data.views + 1;
    }
    function likeChange(listingId) {
      return signedIn() && changed().hasOnly(['likes']) && isPublic(resource.data)
        && ((request.resource.data.likes == resource.data.likes + 1
            && !exists(/databases/$(database)/documents/likes/$(listingId + '_' + request.auth.uid))
            && existsAfter(/databases/$(database)/documents/likes/$(listingId + '_' + request.auth.uid)))
          || (request.resource.data.likes == resource.data.likes - 1
            && request.resource.data.likes >= 0
            && exists(/databases/$(database)/documents/likes/$(listingId + '_' + request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/likes/$(listingId + '_' + request.auth.uid))));
    }
    // 10 reports (settings) from distinct visitors hide the listing until an admin decides.
    // Only verified accounts count towards the automatic hiding (owner's decision of 3 Oct 2026);
    // anonymous or unverified reports are stored for the moderation without touching the listing.
    function reportIncrement(listingId) {
      let d = request.resource.data;
      return isVerified() && !isAnonymous() && changed().hasOnly(['reportsCount', 'hidden'])
        && resource.data.status == 'active'
        && d.reportsCount == resource.data.reportsCount + 1
        && !exists(/databases/$(database)/documents/reports/$(listingId + '_' + request.auth.uid))
        && existsAfter(/databases/$(database)/documents/reports/$(listingId + '_' + request.auth.uid))
        && (d.hidden == resource.data.hidden
          || (d.hidden == true && d.reportsCount >= settings().reportsHideThreshold));
    }
    // Owner's decision 2 (2 Oct 2026): anyone may demote an EXPIRED boost, and nothing else.
    function expiredBoostReset() {
      return resource.data.boostUntil != null && resource.data.boostUntil < request.time
        && changed().hasOnly(['rank', 'boostUntil'])
        && request.resource.data.rank == 0 && request.resource.data.boostUntil == null;
    }
    function moderationOk() {
      let d = request.resource.data;
      return d.status in ['active', 'removed']
        && (d.status == 'removed' ? sized(d.removedReason, 3, maxReason()) : d.removedReason == null)
        && d.hidden is bool
        && (d.reportsCount == resource.data.reportsCount || d.reportsCount == 0);
    }
    function promotionOk() {
      let d = request.resource.data;
      return d.rank in [0, 1, 2] && (d.boostUntil == null || d.boostUntil is timestamp)
        && d.verified is bool;
    }
    // Active → removed comes with the owner's strike in the same batch (SPEC § 10: 5 removals block
    // publication), unless the private record is gone. Removed → active: super-admin only.
    function removalCounted() {
      let owner = /databases/$(database)/documents/users/$(resource.data.ownerUid);
      return !(resource.data.status == 'active' && request.resource.data.status == 'removed')
        || !exists(owner)
        || getAfter(owner).data.strikes == get(owner).data.strikes + 1;
    }
    function reactivationOk() {
      return !(resource.data.status == 'removed' && request.resource.data.status == 'active') || isSuper();
    }
    function adminListingUpdate(listingId) {
      return isAdmin() && audited('listing', listingId) && moderationOk()
        && removalCounted() && reactivationOk()
        // « Classer sans suite » / « Rétablir » date the decision: older reports leave the queue.
        && (!changed().hasAny(['reportsClearedAt']) || request.resource.data.reportsClearedAt == request.time)
        && (changed().hasOnly(['status', 'removedReason', 'hidden', 'reportsCount', 'reportsClearedAt', 'auditId'])
          || (isSuper() && promotionOk()
            && changed().hasOnly(['status', 'removedReason', 'hidden', 'reportsCount', 'reportsClearedAt',
              'rank', 'boostUntil', 'verified', 'auditId'])));
    }
    function isExpired(d) {
      return d.renewedAt + duration.value(listingLifetimeDays(), 'd') < request.time;
    }

    match /listings/{listingId} {
      allow read: if isPublic(resource.data)
        || (signedIn() && resource.data.ownerUid == uid())
        || isAdmin();
      allow create: if isOwnListingId(listingId) && canPublish()
        && validNewListing(listingId, request.resource.data);
      allow update: if ownerEdit(listingId) || ownerClose() || viewIncrement() || likeChange(listingId)
        || reportIncrement(listingId) || expiredBoostReset() || adminListingUpdate(listingId);
      // Owner: any time, except while hidden by reports and awaiting an admin (deleting and
      // republishing would reset the reports). Decision 3: a listing removed by moderation can be
      // erased to free its slot; strikes and auditLog stay. Super-admin: expired listings.
      allow delete: if (signedIn() && resource.data.ownerUid == uid()
          && (resource.data.status == 'removed' || resource.data.hidden == false))
        || (isSuper() && (isExpired(resource.data) || deletionRequested(resource.data.ownerUid)));

      // WhatsApp number: read one document at a time on click, never listable.
      match /private/{docId} {
        // Read on tap only, by a session (an anonymous one for visitors): no scraping without a
        // sign-in (security audit of 3 Oct 2026; App Check is the next step).
        allow get: if docId == 'contact' && signedIn()
          && (isPublic(get(/databases/$(database)/documents/listings/$(listingId)).data)
            || ownsListingId(listingId) || isAdmin());
        allow list: if false;
        allow create, update: if docId == 'contact' && ownsListingId(listingId) && canPublish()
          && exactKeys(request.resource.data, ['whatsapp', 'callAllowed'])
          && validWhatsapp(request.resource.data.whatsapp)
          && request.resource.data.callAllowed is bool
          && request.resource.data.callAllowed
            == (getAfter(/databases/$(database)/documents/listings/$(listingId)).data.contactMode == 'call_message');
        allow delete: if docId == 'contact' && (ownsListingId(listingId)
          || (isSuper() && !existsAfter(/databases/$(database)/documents/listings/$(listingId))));
      }
    }

    // ── likes/{listingId_uid}, reports/{listingId_uid} — one per visitor ───
    match /likes/{likeId} {
      allow get: if signedIn() && likeId.split('_').size() == 3 && likeId.split('_')[2] == uid();
      allow list: if false;
      allow create: if signedIn()
        && exactKeys(request.resource.data, ['listingId', 'uid', 'createdAt'])
        && request.resource.data.uid == uid()
        && likeId == request.resource.data.listingId + '_' + uid()
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.likes
          == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.likes + 1;
      allow update: if false;
      // A like left over from a deleted listing whose slot was reused cannot decrement the new
      // listing (the maintenance job removes such leftovers).
      allow delete: if signedIn() && resource.data.uid == uid()
        && resource.data.createdAt >= get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.createdAt
        && getAfter(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.likes
          == get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.likes - 1;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && exactKeys(request.resource.data, ['listingId', 'uid', 'reason', 'note', 'verified', 'createdAt'])
        && request.resource.data.uid == uid()
        && request.resource.data.verified == (isVerified() && !isAnonymous())
        && reportId == request.resource.data.listingId + '_' + uid()
        && request.resource.data.reason is string && request.resource.data.reason.matches(reportReasonPattern())
        && sized(request.resource.data.note, 0, maxReportNote())
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.reportsCount
          == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.reportsCount
            + (request.resource.data.verified ? 1 : 0);
      allow update, delete: if false;
    }

    // ── boostRequests/{id} + pendingBoosts/{listingId} (one pending request per listing) ──
    function validBoostRequest(requestId, d) {
      return exactKeys(d, ['listingId', 'ownerUid', 'tier', 'operator', 'amount', 'txRef',
          'screenshot', 'status', 'rejectReason', 'createdAt', 'handledBy', 'handledAt'])
        && d.ownerUid == uid()
        && d.listingId is string && ownsListingId(d.listingId)
        && get(/databases/$(database)/documents/listings/$(d.listingId)).data.status == 'active'
        && d.tier in ['premium', 'sponsored']
        && d.operator in ['mtn', 'orange']
        && d.amount == settings().prices[d.tier]
        && (d.txRef == null || sized(d.txRef, 1, maxTxRef()))
        && validDataUrl(d.screenshot)
        && d.status == 'pending' && d.rejectReason == null
        && d.createdAt == request.time && d.handledBy == null && d.handledAt == null
        && !exists(/databases/$(database)/documents/pendingBoosts/$(d.listingId))
        && getAfter(/databases/$(database)/documents/pendingBoosts/$(d.listingId)).data.requestId == requestId;
    }
    function boostDecision() {
      let d = request.resource.data;
      return resource.data.status == 'pending'
        && changed().hasOnly(['status', 'rejectReason', 'handledBy', 'handledAt', 'auditId'])
        && d.handledBy == uid() && d.handledAt == request.time
        && ((d.status == 'approved' && d.rejectReason == null)
          || (d.status == 'rejected' && sized(d.rejectReason, 3, maxReason())))
        && !existsAfter(/databases/$(database)/documents/pendingBoosts/$(resource.data.listingId));
    }

    match /boostRequests/{requestId} {
      allow read: if (signedIn() && resource.data.ownerUid == uid()) || isSuper();
      allow create: if isVerified() && validBoostRequest(requestId, request.resource.data);
      allow update: if isSuper()
        && ((boostDecision() && audited('boostRequest', requestId))
          // « Nettoyage »: erase the screenshot of a handled request.
          || (resource.data.status != 'pending' && changed().hasOnly(['screenshot'])
            && request.resource.data.screenshot == null));
      allow delete: if false;
    }

    match /pendingBoosts/{listingId} {
      allow get: if ownsListingId(listingId) || isSuper();
      allow list: if isSuper();
      allow create: if ownsListingId(listingId) && isVerified()
        && exactKeys(request.resource.data, ['requestId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/boostRequests/$(request.resource.data.requestId)).data.listingId == listingId;
      allow update: if false;
      // Only in the batch that decides the request (never a second request opened by hand).
      allow delete: if isSuper()
        && getAfter(/databases/$(database)/documents/boostRequests/$(resource.data.requestId)).data.status != 'pending';
    }

    // ── verificationRequests/{uid} — ID photo, erased at decision ─────────
    // Fields set by the member; on a new request after a refusal, the admin's `auditId` stays as is.
    function validVerificationSubmit(d) {
      return validDataUrl(d.idImage)
        && d.status == 'pending' && d.createdAt == request.time
        && d.handledBy == null && d.handledAt == null;
    }
    function verificationDecision() {
      let d = request.resource.data;
      return resource.data.status == 'pending'
        && changed().hasOnly(['status', 'idImage', 'handledBy', 'handledAt', 'auditId'])
        && d.status in ['approved', 'rejected'] && d.idImage == null
        && d.handledBy == uid() && d.handledAt == request.time;
    }

    // ID photos: the member and the super-admin only, who decides (owner's decision of 3 Oct 2026).
    match /verificationRequests/{userId} {
      allow get: if isOwner(userId) || isSuper();
      allow list: if isSuper();
      allow create: if isOwner(userId) && isVerified()
        && exactKeys(request.resource.data, ['idImage', 'status', 'createdAt', 'handledBy', 'handledAt'])
        && validVerificationSubmit(request.resource.data);
      allow update: if (isOwner(userId) && isVerified() && resource.data.status == 'rejected'
          && changed().hasOnly(['idImage', 'status', 'createdAt', 'handledBy', 'handledAt'])
          && validVerificationSubmit(request.resource.data))
        || (isSuper() && verificationDecision() && audited('verification', userId));
      allow delete: if isOwner(userId) || (isSuper() && deletionRequested(userId));
    }

    // ── auditLog — created by admins, never modified nor deleted ──────────
    match /auditLog/{entryId} {
      allow read: if isSuper();
      allow create: if isAdmin()
        && exactKeys(request.resource.data, ['actorUid', 'action', 'targetType', 'targetId',
          'before', 'after', 'reason', 'createdAt'])
        && request.resource.data.actorUid == uid()
        && sized(request.resource.data.action, 1, 40)
        && request.resource.data.targetType is string
        && request.resource.data.targetType.matches(auditTargetTypePattern())
        && sized(request.resource.data.targetId, 1, 200)
        && (request.resource.data.reason == null || sized(request.resource.data.reason, 0, maxReason()))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Everything else is refused.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

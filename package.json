{
  "name": "nioxxer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,emu -c magenta,yellow \"vite\" \"firebase emulators:start --only auth,firestore --project demo-nioxxer\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fonts": "node scripts/copy-fonts.mjs",
    "rules:sync": "tsx scripts/sync-rules.ts",
    "pages:sync": "tsx scripts/sync-city-pages.ts",
    "format:check": "prettier --check .",
    "test": "npm run lint && npm run format:check && npm run test:unit && npm run test:rules && npm run build && npm run check:links",
    "check:links": "tsx scripts/check-links.ts",
    "check:legal": "tsx scripts/check-legal.ts",
    "export:v1": "tsx scripts/export-v1.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nioxxer \"vitest run -c vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-nioxxer \"playwright test\"",
    "seed": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seed-emulator.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "deploy:preview": "vite build --mode preview && firebase deploy --only firestore --project nioxxer-staging && firebase hosting:channel:deploy preview --expires 7d --project nioxxer-staging",
    "deploy": "npm run check:legal && npm test && firebase deploy --only hosting,firestore --project nioxxer-staging"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@fontsource/karla": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "20.19.43",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-admin": "13.10.0",
    "firebase-tools": "13.35.1",
    "globals": "17.13.0",
    "lighthouse": "12.8.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
